# Port on the host machine the game is reachable on
HOST_PORT=8080

# Bots fill the island up to this many players while at least one human is online (0 disables bots)
MIN_PLAYERS=4

# Length of a round in seconds (minimum 30)
ROUND_SECONDS=120

# Rounds per match; whoever wins the most rounds wins the match
MATCH_ROUNDS=5

# Only needed if the page is served from a different host than the websocket (comma separated, e.g. game.example.com)
ALLOWED_ORIGINS=
